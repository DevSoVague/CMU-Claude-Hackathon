# Anthropic-compatible Messages API key (CMU AI gateway key, or an Anthropic key with LLM_URL below)
CMU_API_KEY=your-key-here
# Optional: override the endpoint, e.g. https://api.anthropic.com/v1/messages
LLM_URL=https://ai-gateway.andrew.cmu.edu/v1/messages
# Optional: Flask session secret (random per run if unset)
FLASK_SECRET=
